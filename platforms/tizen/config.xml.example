<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets" id="https://rjp.local/stream" version="0.1.0" viewmodes="maximized">
  <name>RJP Stream</name>
  <content src="index.html" />
  <access origin="*" subdomains="true" />
  <tizen:application id="RJPStream.App" package="RJPStream" required_version="6.0" />
  <tizen:profile name="tv-samsung" />
  <tizen:privilege name="http://tizen.org/privilege/internet" />
  <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable" />
</widget>
